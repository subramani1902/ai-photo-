# Security / JWT Configuration
# Required: Must be at least 32 characters
JWT_SECRET_KEY=your_secure_random_secret_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Guest Portal Configuration
GUEST_QR_BASE_URL=http://127.0.0.1:8000/guest
GUEST_QR_EXPIRE_DAYS=30
GUEST_SESSION_EXPIRE_MINUTES=30

# Phase 2: optional Firebase authentication. Existing Supabase/local JWT flows
# remain active. Enable only after configuring actual Admin credentials.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=smphotography-f8c83
FIREBASE_CREDENTIALS_FILE=
# Optional for authentication; required later for temporary selfies/previews.
FIREBASE_STORAGE_BUCKET=
# Emulator mode is local-only and requires a separate demo- project ID.
FIREBASE_EMULATOR_MODE=false

# Public Firebase WEB APP configuration: copy these from the Firebase web app.
# These are NOT service-account credentials. Do not infer missing values.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
